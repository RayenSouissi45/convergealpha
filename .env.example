# Copy to .env for local runs. Never commit .env.
# In GitHub these are Actions secrets (Settings -> Secrets and variables -> Actions).

# Required from Phase 2 (SEC EDGAR asks for a contact e-mail in the User-Agent)
SEC_USER_AGENT="ConvergeAlpha your-email@example.com"

# Recommended (free keys)
FINNHUB_API_KEY=
FRED_API_KEY=

# Optional
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
DANELFIN_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
